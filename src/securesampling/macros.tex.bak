% Safer wrappers replacing line 186-196
\def\BD{\begin{definition}}  \def\ED{\end{definition}}
\def\BCR{\begin{corollary}}
\def\ECR{\end{corollary}}
\def\BEX{\begin{example}}    \def\EEX{\end{example}}
\def\BL{\begin{lemma}}       \def\EL{\end{lemma}}
\def\BP{\begin{proposition}} \def\EP{\end{proposition}}
\def\BCM{\begin{claim}}      \def\ECM{\end{claim}}
\def\BPF{\begin{proof}}      \def\EPF{\end{proof}}
\def\BEN{\begin{enumerate}}
\def\EEN{\end{enumerate}}
\def\BI{\begin{itemize}}
\def\EI{\end{itemize}}
\def\BO{\begin{observation}} 
\def\EO{\end{observation}}
\def\BDS{\begin{description}}
\def\EDS{\end{description}}


