% !TEX root = ../main.tex

% =========================================================
% WEB MODE (Pandoc) - This runs on your Website
% =========================================================
\ifdefined\pandoc
  % 1. FIX MATH ARGUMENTS (The \vec crash)
  % We use \def to force Pandoc to keep the curly braces {}.
  \def\vec#1{\boldsymbol{#1}}
  
  % 2. FIX BRACKETS (Text fallback)
  \def\lbra{[\![} \def\lket{]\!]}
  \def\llbracket{[\![} \def\rrbracket{]\!]}

  % 3. FAKE ALGORITHMS (Prevent "Environment undefined" error)
  \renewenvironment{algorithm}[1][]
    {\medskip\noindent\textbf{Algorithm/Protocol}\par\noindent\hrulefill\par}
    {\noindent\hrulefill\medskip}
  \renewcommand{\caption}[1]{\medskip\noindent\textbf{Caption:} #1 \par}
  \providecommand{\floatname}[2]{}
  
  % 4. FAKE THEOREMS (Simple text blocks)
  % Note: Since main.tex defined them as "real", we redefine them here for web only.
  \providecommand{\theoremstyle}[1]{}
  \renewenvironment{theorem}{\medskip\noindent\textbf{Theorem.}\itshape}{\medskip}
  \renewenvironment{lemma}{\medskip\noindent\textbf{Lemma.}\itshape}{\medskip}
  \renewenvironment{definition}{\medskip\noindent\textbf{Definition.}\itshape}{\medskip}
  \renewenvironment{protocol}{\medskip\noindent\textbf{Protocol.}\itshape}{\medskip}
  \renewenvironment{fact}{\medskip\noindent\textbf{Fact.}\itshape}{\medskip}
  \renewenvironment{claim}{\medskip\noindent\textbf{Claim.}\itshape}{\medskip}
  \renewenvironment{corollary}{\medskip\noindent\textbf{Corollary.}\itshape}{\medskip}
  \renewenvironment{proposition}{\medskip\noindent\textbf{Proposition.}\itshape}{\medskip}
  \renewenvironment{example}{\medskip\noindent\textbf{Example.}\itshape}{\medskip}
  \renewenvironment{observation}{\medskip\noindent\textbf{Observation.}\itshape}{\medskip}
  \renewenvironment{proof}{\medskip\noindent\textbf{Proof.}\itshape}{\medskip}

  % 5. FAKE COMMANDS
  \providecommand{\State}{\noindent $\bullet$ }
  \providecommand{\Require}{\noindent\textbf{Require: }}
  \providecommand{\Ensure}{\noindent\textbf{Ensure: }}
  \providecommand{\Return}{\noindent\textbf{Return: }}
  \providecommand{\qedsymbol}{\ensuremath{\blacksquare}}
  
  % 6. FAKE BOXES
  \newcommand{\bbox}[1]{\medskip \noindent #1 \medskip}
  \newcommand{\tbox}[1]{\medskip \noindent #1 \medskip}

% =========================================================
% PDF MODE (Overleaf) - This runs for your PDF
% =========================================================
\else
  % 1. Real Math Vector
  \renewcommand{\vec}[1]{\mathbf{#1}}

  % 2. Real Brackets
  \providecommand{\lbra}{\llbracket}
  \providecommand{\lket}{\rrbracket}
  \providecommand{\llbracket}{\llbracket}
  \providecommand{\rrbracket}{\rrbracket}
  
  % 3. Real Boxes
  \newcommand{\bbox}[1]{
    \medskip
    \fbox{\hbox{\medskip
      \begin{minipage}{0.90\textwidth} \small #1 \end{minipage}
    \quad}
  }} 
  \newcommand{\tbox}[1]{
    \medskip
    \noindent
    \fbox{\hbox{\medskip
      \begin{minipage}{0.9\textwidth} #1 \end{minipage}
    \quad}
    } \medskip
  } 
  
  % Note: We do NOT define \newtheorem here. 
  % They MUST be defined in main.tex to avoid Preamble errors.
\fi

% =========================================================
% SHARED MACROS (Safe everywhere)
% =========================================================

% Protocol names
\providecommand{\flatten}{\mathsf{flatten}}

% Greek letters & Variables
\providecommand{\e}{\epsilon}
\renewcommand{\d}{\delta} 
\renewcommand{\a}{\alpha}
\renewcommand{\b}{\beta}
\def\u{\upsilon}
\providecommand{\edp}{\e}
\providecommand{\ddp}{\d}
\providecommand{\esketch}{\widetilde{\e}}
\providecommand{\dsketch}{\widetilde{\d}}
\providecommand{\efinal}{\overline{\e}}
\providecommand{\dfinal}{\overline{\d}}
\providecommand{\fmin}{\min(f)}

% Math Operators
