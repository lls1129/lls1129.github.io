% !TEX root = ../main.tex

\ifdefined\pandoc
  % --- WEB MODE ---
  \def\vec#1{\boldsymbol{#1}}
  \def\lbra{[\![} \def\lket{]\!]}
  \def\llbracket{[\![} \def\rrbracket{]\!]}

  % Fake Environments (to match the ones we defined in main.tex)
  \renewenvironment{algorithm}[1][]{\medskip\noindent\textbf{Algorithm}\par}{\medskip}
  \renewcommand{\caption}[1]{\textbf{Caption:} #1 \par}
  \providecommand{\floatname}[2]{}
  
  \renewenvironment{theorem}{\medskip\noindent\textbf{Theorem.}\itshape}{\medskip}
  \renewenvironment{lemma}{\medskip\noindent\textbf{Lemma.}\itshape}{\medskip}
  \renewenvironment{definition}{\medskip\noindent\textbf{Definition.}\itshape}{\medskip}
  \renewenvironment{protocol}{\medskip\noindent\textbf{Protocol.}\itshape}{\medskip}
  \renewenvironment{fact}{\medskip\noindent\textbf{Fact.}\itshape}{\medskip}
  \renewenvironment{proof}{\medskip\noindent\textit{Proof.}}{\medskip}

  % Fake Commands
  \providecommand{\State}{\bullet~}
  \providecommand{\Require}{\textbf{Require: }}
  \providecommand{\Ensure}{\textbf{Ensure: }}

\else
  % --- PDF MODE ---
  \renewcommand{\vec}[1]{\mathbf{#1}}
  \providecommand{\lbra}{\llbracket}
  \providecommand{\lket}{\rrbracket}
  % Note: We do NOT define \newtheorem here anymore. 
  % They are in main.tex now.
\fi

