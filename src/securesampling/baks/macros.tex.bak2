% =========================================================
% SHARED MACROS (Safe everywhere)
% =========================================================
% \providecommand{\flatten}{\mathsf{flatten}}
% \providecommand{\e}{\epsilon}
% ... (Paste your other definitions here) ...

% Protocol names
\providecommand{\flatten}{\mathsf{flatten}}

% Greek letters & Variables
\providecommand{\e}{\epsilon}
\renewcommand{\d}{\delta} % Delta is common, rename carefully
\renewcommand{\a}{\alpha}
\renewcommand{\b}{\beta}
\def\u{\upsilon}
\providecommand{\edp}{\e}
\providecommand{\ddp}{\d}
\providecommand{\esketch}{\widetilde{\e}}
\providecommand{\dsketch}{\widetilde{\d}}
\providecommand{\efinal}{\overline{\e}}
\providecommand{\dfinal}{\overline{\d}}
\providecommand{\fmin}{\min(f)}

% Math Operators
\renewcommand{\vec}[1]{\mathbf{#1}}
\def\NN{\mathbb{N}}
\def\RR{\mathbb{R}}
\def\F{\mathcal{F}}
\def\XXX{\mathcal{X}}
\def\QQ{\mathbb{Q}}
\def\SD{{\sf SD}}
\def\D{\Delta}
\def\from{\leftarrow}

% Cryptographic Primitives
\def\ParamGen{{\sf ParamGen}}
\def\SecKeygen{{\sf SecKeygen}}
\def\params{{\sf Params}}
\def\SecEncrypt{{\sf SecEncrypt}}
\def\EvalAdd{{\sf EvalAdd}}
\def\EvalMult{{\sf EvalMult}}
\def\Enc{{\sf Enc}}
\def\Gen{{\sf Gen}}
\def\Dec{{\sf Dec}}
\def\PDF{{\sf PDF}}
\def\tx{{\intercal}}
\newcommand{\HHH}{\mathcal{H}}
\def\UU{\mathbb{U}}
\def\bra{\langle}
\def\ket{\rangle}
\def\xor{\oplus}
\def\Encode{\mathsf{Encode}}
\def\Decode{\mathsf{Decode}}
\def\pk{\textsc{pk}}
\def\sk{\textsc{sk}}
\def\ek{\textsc{ek}}
\def\polylog{\mathsf{polylog}}

% Fix for the brackets using the logic defined at top
\def\lbra{\llbracket}
\def\lket{\rrbracket}

\def\nil{{\mathsf{nil}}}
\def\trunc{{\mathsf{trunc}}}
\def\prec{{\mathsf{approx}}}
\def\flat{{\mathsf{approx}}}
\def\appr{{\mathsf{approx}}}
\def\rounding{{\mathsf{rounding}}}
\def\coinflip{{\mathsf{coinflip}}}
\def\rsample{{\mathsf{rsample}}}
\def\oslone{{\mathsf{osample(L_1)}}}
\def\bcoin{{\mathsf{biasCoin}}}
\def\Sim{{\mathsf{Sim}}}
\def\vd{{\vec{d}}}
\def\mask{{\sf mask}}
\newcommand{\wl}[1]{\|\w_{#1}\|_1}

% Formatting
\renewcommand{\paragraph}[1]{\medskip \noindent\textbf{#1}}

\providecommand{\negl}{\mathsf{negl}}
\providecommand{\zo}{\{0,1\}}
\providecommand{\bitset}{\{0,1\}}
\providecommand{\idx}{\mathsf{idx}}
\renewcommand{\to}{\rightarrow}
\renewcommand{\sec}{\lambda}
\newcommand{\SSS}{{\cal S}}
\newcommand{\Exp}{{\bf Exp}}
\newcommand{\Var}{{\bf Var}}
\newcommand{\Null}{{\sf null}}
\newcommand{\ignore}[1]{}
\def\ig{\mathrm{ignore}}

% Font stuff
\newcommand{\mc}[1]{\mathcal{#1}}
\newcommand{\Left}{\mathsf{left}}
\newcommand{\Right}{\overline{\mathsf{left}}}

\def\fhe{\mathsf{FHE}}
\def\ssp{\mathsf{sec\mbox{-}search}}
\def\Game{\mathsf{Game}_\fhe^\ssp(\mc{A})}
\def\Adv{\mathsf{Adv}_\fhe^\ssp(\mc{A})}

% MPC stuff
\newcommand{\A}{\mc{A}}
\renewcommand{\S}{\mathsf{Sim}}
\newcommand{\View}{\mathsf{View}}
\newcommand{\Out}{\mathsf{Out}}
\newcommand{\flone}{\mathsf{F}_{L_1}}

% ==========================================
% 3. ENVIRONMENT WRAPPERS (The Trickiest Part)
% ==========================================
% Pandoc handles `\begin{proof}` natively if using standard packages.
% We map your custom shortcuts to standard LaTeX environments.

\providecommand{\BD}{\begin{definition}}
\providecommand{\ED}{\end{definition}}
\providecommand{\BCR}{\begin{corollary}}
\providecommand{\ECR}{\end{corollary}}
\providecommand{\BEX}{\begin{example}}
\providecommand{\EEX}{\end{example}}
\providecommand{\BL}{\begin{lemma}}
\providecommand{\EL}{\end{lemma}}
\providecommand{\BP}{\begin{proposition}}
\providecommand{\EP}{\end{proposition}}
\providecommand{\BCM}{\begin{claim}}
\providecommand{\ECM}{\end{claim}}
\providecommand{\BPF}{\begin{proof}}
\providecommand{\EPF}{\end{proof}}
\providecommand{\BEN}{\begin{enumerate}}
\providecommand{\EEN}{\end{enumerate}}
\providecommand{\BI}{\begin{itemize}}
\providecommand{\EI}{\end{itemize}}
\providecommand{\BO}{\begin{observation}}
\providecommand{\EO}{\end{observation}}
\providecommand{\BDS}{\begin{description}}
\providecommand{\EDS}{\end{description}}

% ==========================================
% 4. BOXES (Web-Unsafe)
% ==========================================
% These minipages break HTML layout. 
% If on web, we just output the text without the box.

\ifdefined\pandoc
  \newcommand{\bbox}[1]{\medskip \noindent #1 \medskip}
  \newcommand{\tbox}[1]{\medskip \noindent #1 \medskip}
\else
  \newcommand{\bbox}[1]{
    \medskip
    \fbox{\hbox{\medskip
      \begin{minipage}{0.90\textwidth}
      \small
      #1
      \end{minipage}
    \quad}
  }} 
  \newcommand{\tbox}[1]{
    \medskip
    \noindent
    \fbox{\hbox{\medskip
      \begin{minipage}{0.9\textwidth}
      #1
      \end{minipage}
    \quad}
    }
    \medskip
  } 
\fi

\newcommand{\DDD}{{\cal D}}
\newcommand{\RRR}{{\cal R}}

