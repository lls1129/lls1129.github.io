\newcommand{\secparam}{\lambda}
\newcommand{\nibf}[1]{\noindent\textbf{#1}}

\newcommand{\ip}[2]{\langle #1, #2 \rangle}
\newcommand{\eps}{\epsilon}
\newcommand{\Fp}{\F_{\mathsf{prod}}}
\newcommand{\Pp}{\Pi_{\mathsf{prod}}}
\newcommand{\Dp}{D_{\mathsf{prod}}}
\newcommand{\Fip}{\F_{\mathsf{aIP}}}
\newcommand{\flk}{f_{\mathsf{Leak}}} % Renamed fl to flk to avoid conflict
\newcommand{\ipw}{\ip{\vec{w}_1}{\vec{w}_2}}
\newcommand{\LLw}{\|\w_1 + \w_2 \|_2^2}
\def\w{\vec{w}}
\def\take{\mathsf{Take}}
\def\view{\mathsf{view}}
\def\dIP{\mathsf{DP}\mbox{-}\mathsf{approxIP}}

\newcommand{\aIPabort}{\mathsf{approxIPwAbort}}
\newcommand{\Output}{\mathsf{Output}}
