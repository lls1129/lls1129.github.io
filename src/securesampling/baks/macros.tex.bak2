
% If running in Pandoc (Web), we define brackets manually to avoid package errors.
\ifdefined\pandoc
  \providecommand{\llbracket}{[\![}
  \providecommand{\rrbracket}{]\!]}
% \else
%   % If running in PDF (Overleaf), load the real packages
%   \usepackage{stmaryrd} 
\fi

% ==========================================
% 2. GENERAL MACROS (Safe for both)
% ==========================================

% !TEX root = main.tex

% =========================================================
% WEB MODE (Pandoc)
% =========================================================
\ifdefined\pandoc
  % 1. FIX THE YELLOW ERROR (Missing argument for \mathbf)
  \def\vec#1{\boldsymbol{#1}}
  
  % 2. FIX THE RED TEXT (Brackets)
  \def\lbra{[\![} \def\lket{]\!]}
  \def\llbracket{[\![} \def\rrbracket{]\!]}

  % 3. FAKE ALGORITHMS (Prevent "Environment undefined" error)
  \renewenvironment{algorithm}[1][]
    {\medskip\noindent\textbf{Algorithm/Protocol}\par\noindent\hrulefill\par}
    {\noindent\hrulefill\medskip}
  \renewcommand{\caption}[1]{\medskip\noindent\textbf{Caption:} #1 \par}
  \providecommand{\floatname}[2]{}
  
  % 4. FAKE THEOREMS (Simple text blocks)
  \providecommand{\theoremstyle}[1]{}
  \renewenvironment{theorem}{\medskip\noindent\textbf{Theorem.}\itshape}{\medskip}
  \renewenvironment{lemma}{\medskip\noindent\textbf{Lemma.}\itshape}{\medskip}
  \renewenvironment{definition}{\medskip\noindent\textbf{Definition.}\itshape}{\medskip}
  \renewenvironment{protocol}{\medskip\noindent\textbf{Protocol.}\itshape}{\medskip}
  \renewenvironment{fact}{\medskip\noindent\textbf{Fact.}\itshape}{\medskip}
  \renewenvironment{claim}{\medskip\noindent\textbf{Claim.}\itshape}{\medskip}

  % 5. FAKE COMMANDS
  \providecommand{\State}{\noindent $\bullet$ }
  \providecommand{\Require}{\noindent\textbf{Require: }}
  \providecommand{\Ensure}{\noindent\textbf{Ensure: }}

% =========================================================
% PDF MODE (Overleaf) - This runs for your PDF
% =========================================================
\else
  % 1. Real Math Vector
  \renewcommand{\vec}[1]{\mathbf{#1}}

  % 2. Real Brackets
  \providecommand{\lbra}{\llbracket}
  \providecommand{\lket}{\rrbracket}
  \providecommand{\llbracket}{\llbracket}
  \providecommand{\rrbracket}{\rrbracket}

  % 3. REAL THEOREMS (Order is CRITICAL here)
  % We assume \usepackage{amsthm} is in main.tex
  
  % Step A: Define the Parent Counter first
  \newtheorem{theorem}{Theorem}[section] 
  
  % Step B: Define the Children (that use [theorem])
  \newtheorem{lemma}[theorem]{Lemma}
  \newtheorem{definition}[theorem]{Definition}
  \newtheorem{protocol}[theorem]{Protocol}
  \newtheorem{fact}[theorem]{Fact}     % This fixes "No counter 'theorem' defined"
  \newtheorem{claim}[theorem]{Claim}   % This fixes "No counter 'theorem' defined"
\fi
