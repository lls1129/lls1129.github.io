abstract = {Private Set Intersection Cardinality(PSI-CA) is an important type of secure two-party computation. It has wide applications in federated machine learning. It enables two parties, each holding a private set, to jointly compute the cardinality of their intersection without revealing any other private information about their respective sets. In this paper, we manage to break two PSI-CA protocols in polynomial time by recovering the private intersection set. Among them, the PSI-CA protocol proposed by De Cristofaro et al. in 2012 is the most popular PSI-CA protocol based on the Google Scholar search results and it is still deemed one of the most efficient PSI-CA protocols. We also propose several solutions to these protocols’ security problems in this paper.},
booktitle = {Proceedings of the 2024 16th International Conference on Machine Learning and Computing},
pages = {65–72},
numpages = {8},
keywords = {DDH, DLP, PSI-CA, Private Set Intersection},
location = {Shenzhen, China},
series = {ICMLC '24}
}

